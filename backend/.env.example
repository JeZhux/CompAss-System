APP_NAME=CompAss
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=compass
DB_USERNAME=compass
DB_PASSWORD=compass

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1,127.0.0.1:3000,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated reverse-proxy IPs whose X-Forwarded-* headers are trusted
# (REM-044). Empty = trust no proxy (the socket IP is used directly).
# Deployment-only: leave empty for direct PHP-FPM; set to 127.0.0.1 when an
# on-host Apache/Nginx proxy fronts the app.
TRUSTED_PROXIES=

# OpenRouter AI proxy (AIService). The mock is an APP_ENV-restricted test
# harness (REM-029): OPENROUTER_MOCK must be false in production/local except
# local dev against a canned response. NEVER ship mock=true outside non-
# production environments — mock output is never stored as real explanations
# (REQ-DEC-008, ARCH-DEC-005).
OPENROUTER_API_KEY=
# Model served via the AIService OpenRouter proxy (TECH-DEC-010); env-configurable per environment.
OPENROUTER_MODEL=
OPENROUTER_MOCK=false
# OPENROUTER_MOCK_RESPONSE={"choices":[{"message":{"content":"Mock explanation."}}]}

# REM-040 provisioning admin (BootstrapAdminSeeder): created on `db:seed` only
# when BOOTSTRAP_ADMIN_NAME and BOOTSTRAP_ADMIN_PASSWORD are both set; otherwise
# the seeder is a no-op. Local/dev may use a throwaway dev password here; the
# admin is created with must_change_password=true, so its first login is forced
# through the password-change flow. Production: keep EMPTY in this template —
# set real values directly on the host .env, never commit credentials (REM-010).
# CompAss-ID rework: school_id is always server-generated (ADM-XXXX-XXXXX);
# no email or school_id input exists. Record the printed CompAss ID as login.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
