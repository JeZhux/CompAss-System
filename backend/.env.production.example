# Production env template (ARCH-006 §6) — copy to .env on the host.
# Copy this file to `.env` on the pilot host and fill in the placeholders below.

APP_NAME=CompAss
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<pilot-host>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# ARCH-002 QA-002: the app clock is Asia/Manila (UTC+8) by default (config/app.php);
# the server's php.ini MUST set date.timezone=Asia/Manila to match (php.ini is
# a deployment setting — it is not stored in this repo).

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
# Supabase Postgres pilot: pooled host + mandatory TLS.
# Runtime app traffic uses the pooled port 6543; one-off migrations use direct 5432
# (swap DB_PORT to 5432 for `php artisan migrate`). DB_SSLMODE=require always.
DB_HOST=db.xxx.supabase.co
DB_PORT=6543
DB_DATABASE=compass
DB_USERNAME=compass
DB_PASSWORD=
DB_SSLMODE=require

# ARCH-002 QA-004/ARCH-002 FR-002: 30-min session inactivity timeout; session cookies must be
# encrypted and HTTPS-only in production (ARCH-006 §7).
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Cross-site Vercel frontend: SameSite=None requires Secure (true above).
SESSION_SAME_SITE=none
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Supabase S3 pilot: private bucket compass-private, keys backend-only (never commit).
FILESYSTEM_DISK=s3
# ARCH-002 QA-005: no async infrastructure — sync queue, database cache.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pilot handoff: log mailer; swap to smtp if admin requires real mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=compass-private
# Supabase S3 endpoint (S3-compatible); path-style required.
AWS_ENDPOINT=https://<supabase-project-ref>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# SEC-DEC-018: replace with the Vercel host; never use `*`
SANCTUM_STATEFUL_DOMAINS=<vercel-host>

# Same no-wildcard rule as SANCTUM_STATEFUL_DOMAINS (SEC-DEC-018).
CORS_ALLOWED_ORIGINS=https://<vercel-host>

# SEC-DEC-018: on-host Apache/Nginx reverse proxy in front of PHP-FPM (ARCH-006 §4).
# Comma-separated trusted proxy IPs whose X-Forwarded-For is honored. The host
# firewall MUST ensure only this proxy can reach PHP-FPM — otherwise clients
# could spoof their IP in audit logs and login rate-limit counters (ARCH-002 QA-006/ARCH-002 QA-004).
TRUSTED_PROXIES=127.0.0.1

# OpenRouter AI proxy (AIService). SEC-DEC-013: the API key lives only in the
# server .env, never in a committed template — keep this value EMPTY here.
# ARCH-006 §6: OPENROUTER_MOCK must be false in production.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ARCH-006 §5.1 provisioning admin (BootstrapAdminSeeder): created on `db:seed` only
# when BOOTSTRAP_ADMIN_NAME and BOOTSTRAP_ADMIN_PASSWORD are both set; otherwise
# the seeder is a no-op. SEC-DEC-013/ARCH-006 §5.1 hygiene: credentials live ONLY in
# the host .env, never in a committed template — keep these values EMPTY here.
# CompAss-ID rework: school_id is always server-generated (ADM-XXXX-XXXXX);
# no email or school_id input exists. Record the printed CompAss ID as login.
# The admin is created with must_change_password=true, so the first login is
# forced through the password-change flow (ARCH-002 FR-038).
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"