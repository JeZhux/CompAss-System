# Local (preferred): empty = same-origin relative via Vite dev proxy (/api + /sanctum → 127.0.0.1:8000).
# Avoids CORS / SameSite cross-site CSRF mismatches (localhost:3000 vs 127.0.0.1:8000).
# Direct-origin local alternative: VITE_API_BASE=http://127.0.0.1:8000
# Vercel pilot: VITE_API_BASE=https://<backend-host> (no trailing /api; client appends /api + /sanctum).
VITE_API_BASE=
